{
  "name": "CaseStudy",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "enum": [
        "dental",
        "medical",
        "local_services",
        "ecommerce"
      ]
    },
    "excerpt": {
      "type": "string"
    },
    "challenge": {
      "type": "string"
    },
    "strategy": {
      "type": "string"
    },
    "results": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "featured_image": {
      "type": "string"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug",
    "industry"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
